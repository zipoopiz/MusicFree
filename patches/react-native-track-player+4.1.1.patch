+    /** 复制原元数据的全部字段并写入一个字符串字段（MediaMetadataCompat.Builder 无复制构造） */
+    private fun MediaMetadataCompat.withString(key: String, value: String): MediaMetadataCompat {
+        val builder = MediaMetadataCompat.Builder()
+        for (k in keySet()) {
+            when (k) {
+                MediaMetadataCompat.METADATA_KEY_DURATION,
+                MediaMetadataCompat.METADATA_KEY_TRACK_NUMBER,
+                MediaMetadataCompat.METADATA_KEY_NUM_TRACKS,
+                MediaMetadataCompat.METADATA_KEY_DISC_NUMBER,
+                MediaMetadataCompat.METADATA_KEY_YEAR -> builder.putLong(k, getLong(k))
+                else -> {
